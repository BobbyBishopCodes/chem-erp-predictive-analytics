		summarizeBy: none
		sourceColumn: COGS cents

	partition Sales = m
		mode: import
		source =
				let
				    Rows = Json.Document(Binary.FromText("", BinaryEncoding.Base64)),
				    Source = Table.FromRows(Rows, {"Month", "Product ID", "Revenue cents", "COGS cents"}),
				    Typed = Table.TransformColumnTypes(Source, {{"Month", type text}, {"Product ID", type text}, {"Revenue cents", Int64.Type}, {"COGS cents", Int64.Type}}, "en-US")
				in
				    Typed

