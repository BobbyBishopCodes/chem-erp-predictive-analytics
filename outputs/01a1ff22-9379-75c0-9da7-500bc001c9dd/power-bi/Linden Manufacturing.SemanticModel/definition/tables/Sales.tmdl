table Sales
	lineageTag: 0512de72-2c7e-4f53-b5be-0db9e54ea6ab

	measure 'Gross margin' = DIVIDE(SUM(Sales[Revenue cents]) - SUM(Sales[COGS cents]), SUM(Sales[Revenue cents]))
