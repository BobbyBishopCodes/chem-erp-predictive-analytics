	column 'Scrap kg'
		dataType: int64
		isHidden
		lineageTag: 696ef451-1841-4a1d-9bd6-796f8e56eefa
		summarizeBy: none
		sourceColumn: Scrap kg

	partition Production = m
		mode: import
		source =
				let
				    Rows = Json.Document(Binary.FromText("", BinaryEncoding.Base64)),
				    Source = Table.FromRows(Rows, {"Month", "Product ID", "Cost cents", "Budget cents", "Good kg", "Scrap kg"}),
				    Typed = Table.TransformColumnTypes(Source, {{"Month", type text}, {"Product ID", type text}, {"Cost cents", Int64.Type}, {"Budget cents", Int64.Type}, {"Good kg", Int64.Type}, {"Scrap kg", Int64.Type}}, "en-US")
				in
				    Typed

