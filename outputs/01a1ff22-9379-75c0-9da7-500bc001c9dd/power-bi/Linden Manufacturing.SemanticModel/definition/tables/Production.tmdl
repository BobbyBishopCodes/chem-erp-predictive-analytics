table Production
	lineageTag: 0bc8ae99-3de6-4efa-b5b0-2d55e516c5d0

	measure 'Actual cost' = DIVIDE(SUM(Production[Cost cents]), 100)
		formatString: $#,0;($#,0);$0
		lineageTag: ee7de793-fff9-4271-83de-8581867f52ae

	measure 'Budget cost' = DIVIDE(SUM(Production[Budget cents]), 100)
		formatString: $#,0;($#,0);$0
		lineageTag: 03513ff1-4fd0-40cd-9eca-5019529554fe

	measure 'Production yield' = DIVIDE(SUM(Production[Good kg]), SUM(Production[Good kg]) + SUM(Production[Scrap kg]))
		formatString: 0.0%
		lineageTag: 2dd91e86-a80c-44c1-b300-b4bfeca0bd27

	column Month
		dataType: string
		isHidden
		lineageTag: b08f6880-984d-4bec-bd34-f2cf07c8d96e
		summarizeBy: none
		sourceColumn: Month

	column 'Product ID'
		dataType: string
		isHidden
		lineageTag: 4605a29b-e0ef-4ad3-97ef-3df129d4bd57
		summarizeBy: none
		sourceColumn: Product ID

	column 'Cost cents'
