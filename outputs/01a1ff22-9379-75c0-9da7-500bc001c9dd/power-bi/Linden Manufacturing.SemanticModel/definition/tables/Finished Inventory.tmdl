table 'Finished Inventory'
	lineageTag: 459fd356-c472-47ae-95d0-4caf1c809e83

	measure 'Finished goods' = DIVIDE(SUM('Finished Inventory'[Value cents]), 100)
		formatString: $#,0;($#,0);$0
		lineageTag: 6c482efc-3f8a-40dd-8720-266ae5ab7d23

	measure 'Ending finished inventory' = CALCULATE([Finished goods], 'Calendar'[Month] = MAX('Calendar'[Month]))
		formatString: $#,0;($#,0);$0
		lineageTag: d31832ad-fff2-4010-b743-87bc90d15c20

	column Month
		dataType: string
		isHidden
		lineageTag: 6e46b0bd-c163-43c4-a66d-62617a59091e
		summarizeBy: none
		sourceColumn: Month

	column 'Product ID'
		dataType: string
		isHidden
		lineageTag: b304230e-4943-49cc-9b5d-d6203a42d8b4
		summarizeBy: none
		sourceColumn: Product ID

	column 'Value cents'
		dataType: int64
		isHidden
		lineageTag: 8d62c63a-e348-42c9-b592-694cf7608c8f
		summarizeBy: none
		sourceColumn: Value cents

	partition 'Finished Inventory' = m
		mode: import
		source =
				let
				    Rows = Json.Document(Binary.FromText("", BinaryEncoding.Base64)),
				    Source = Table.FromRows(Rows, {"Month", "Product ID", "Value cents"}),
				    Typed = Table.TransformColumnTypes(Source, {{"Month", type text}, {"Product ID", type text}, {"Value cents", Int64.Type}}, "en-US")
				in
				    Typed

