table 'Raw Inventory'
	lineageTag: 16c6bad1-d11f-45ae-bbfa-e873c5e52776

	measure 'Raw materials (company)' = DIVIDE(SUM('Raw Inventory'[Value cents]), 100)
		formatString: $#,0;($#,0);$0
		lineageTag: 785d614a-1605-4ee5-b9ba-31ba5d726b71

	column Month
		dataType: string
		isHidden
		lineageTag: 13e0109b-e055-41e5-a129-243dbb3870d5
		summarizeBy: none
		sourceColumn: Month

	column 'Value cents'
		dataType: int64
		isHidden
		lineageTag: 8b796351-fe6a-483b-8534-edc33893952b
		summarizeBy: none
		sourceColumn: Value cents

	partition 'Raw Inventory' = m
		mode: import
		source =
				let
				    Rows = Json.Document(Binary.FromText("", BinaryEncoding.Base64)),
				    Source = Table.FromRows(Rows, {"Month", "Value cents"}),
				    Typed = Table.TransformColumnTypes(Source, {{"Month", type text}, {"Value cents", Int64.Type}}, "en-US")
				in
				    Typed

